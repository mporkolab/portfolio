# A mentéskor induló újraépítés végpontja, systemd service-ként.
#
# Telepítés (az útvonalakat igazítsd, ha a repo máshol van):
#   sudo cp cms/rebuild-hook.service /etc/systemd/system/portfolio-rebuild-hook.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now portfolio-rebuild-hook
#
# Napló: journalctl -u portfolio-rebuild-hook -f
#
# root-ként fut, mert a rebuild.sh docker parancsokat ad ki; a docker csoport
# tagjaként futó felhasználó ugyanennyit tehetne, úgyhogy ez nem jelent többet.

[Unit]
Description=Portfolio rebuild hook (Directus save -> cms/rebuild.sh)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/mnt/storage/portfolio
# A REBUILD_TOKEN, a REBUILD_HOST és a REBUILD_PORT innen jön — ugyanaz a fájl,
# amiből a setup.mjs a Flow-t felveszi, így a token csak egy helyen él.
EnvironmentFile=/mnt/storage/portfolio/cms/.env
ExecStart=/usr/bin/env node cms/rebuild-hook.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
