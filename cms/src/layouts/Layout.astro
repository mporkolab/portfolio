---
/**
 * A CMS oldalainak elrendezése: felső sáv a névvel és a projektlistára mutató
 * linkkel, alatta a tartalom. Egy menüpont van, így nincs oldalsáv.
 */
import "../styles/cms.css";
import "@fontsource-variable/inter";
import { env } from "../lib/env";

interface Props {
    title: string;
}

const { title } = Astro.props;
const portfolio = env("PORTFOLIO_URL")?.replace(/\/$/, "");
---

<!doctype html>
<html lang="hu">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />
        <title>{title} · Portfólió CMS</title>
    </head>
    <body class="min-h-dvh">
        <header class="border-b border-admin-border bg-admin-panel">
            <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
                <a href="/" class="text-sm font-bold tracking-[0.2em] uppercase">
                    P. Martin <span class="text-admin-muted">| CMS</span>
                </a>
                {
                    portfolio && (
                        <a href={portfolio} target="_blank" rel="noopener" class="text-sm text-admin-muted hover:text-accent">
                            Portfólió ↗
                        </a>
                    )
                }
            </div>
        </header>
        <div class="mx-auto max-w-7xl">
            <div class="flex flex-wrap items-center justify-between gap-4 px-5 pt-6 sm:px-8 lg:pt-8">
                <h1 class="text-2xl font-bold sm:text-3xl">{title}</h1>
                <slot name="actions" />
            </div>
            <main class="px-5 py-6 sm:px-8">
                <slot />
            </main>
        </div>
    </body>
</html>
