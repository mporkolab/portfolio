# Másold cms/.env-be és töltsd ki. A cms/.env nincs verziókövetve.
# A KEY és a SECRET bármilyen hosszú random sztring lehet:
#   openssl rand -hex 32
CMS_KEY=
CMS_SECRET=
DB_PASSWORD=
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
# Éles homelabon: https://cms.martinporkolab.hu
CMS_PUBLIC_URL=http://localhost:8055
CMS_PORT=8055

# A mentéskor induló újraépítés. Üresen hagyva a setup.mjs nem hoz létre Flow-t.
REBUILD_HOOK_URL=http://host.docker.internal:9009/rebuild
REBUILD_TOKEN=
