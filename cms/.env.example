# Másold cms/.env-be és töltsd ki. A cms/.env nincs verziókövetve.
# A cms és a portfólió konténere is ezt kapja (a PREVIEW_SECRET kell mindkettőnek).

# Az a cím (vagy címek, vesszővel), ahonnan a CMS-t böngészőben nyitod. Más
# címre érkező kérést a CMS nem szolgál ki (DNS rebinding ellen); a localhost
# mindig mehet. Éles homelabon a Tailscale-cím, pl.
#   http://100.71.44.91:2368
CMS_URL=http://localhost:2368

# Melyik hálózati címen hallgasson a CMS portja a hoszton. A CMS-nek nincs
# belépése: aki eléri, szerkeszthet – ezért élesben a Tailscale-cím (pl.
# 100.71.44.91), soha ne 0.0.0.0 egy internetre nyitott gépen.
CMS_BIND=127.0.0.1
CMS_PORT=2368

# Előnézet a valódi portfólión (a „Előnézet” gombok). Mindkettő kell hozzá.
#   PORTFOLIO_URL   a portfólió címe, ahogy a böngésződ eléri, az al-útvonallal
#                   együtt, ha van (pl. https://martinporkolab.hu vagy
#                   http://localhost:8080)
#   PREVIEW_SECRET  bármilyen hosszú, random sztring: openssl rand -hex 32
#                   (a portfólió konténere ugyanezt kapja)
PORTFOLIO_URL=http://localhost:8080
PREVIEW_SECRET=
