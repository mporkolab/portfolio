# Másold .env-be és töltsd ki. A .env nincs verziókövetve.

# A nyilvános kapcsolati cím, ahogy az oldalon megjelenik.
PUBLIC_CONTACT_EMAIL=

# A form-szolgáltató JSON endpointja, pl.
#   Formspree:  https://formspree.io/f/xxxxxxxx
#   Basin:      https://usebasin.com/f/xxxxxxxx
#   Web3Forms:  https://api.web3forms.com/submit
# Üresen hagyva a Küldés a látogató levelezőjét nyitja meg.
PUBLIC_CONTACT_ENDPOINT=

# Csak Web3Forms-hoz kell (a kulcs a kérés törzsében utazik, nem az URL-ben).
PUBLIC_CONTACT_ACCESS_KEY=

# A futó konténer hosztportja.
PORT=8080

# Ha az oldal egy reverse proxy al-útvonalán áll, a prefix / nélkül (pl.
# portfolio). Üresen a domain gyökerére épül.
BASE_PATH=

# A nyilvános cím, séma + domain, / nélkül. Ebből lesznek a keresőknek és a
# megosztási előnézeteknek szánt abszolút linkek (canonical, hreflang, Open
# Graph, sitemap). Üresen https://martinporkolab.hu.
SITE_URL=

# A CMS (cms/) adatbázisa és képei. Csak a portfólió szervere olvassa őket, a
# látogató soha (a képeket is a szerver adja tovább), így a CMS-nek nem kell
# nyilvánosnak lennie. Fejlesztésben (npm run dev) az alapértelmezés jó: a CMS
# a cms/data mappába ír. A konténerben a cms-data volume-on vannak, azt az
# image adja meg. Az előnézethez kell PREVIEW_SECRET a cms/.env-ben (a
# konténer onnan kapja); dev szerverhez ide is írd be ugyanazt.
#
#   CMS_DATABASE=cms/data/cms.db
#   CMS_UPLOADS=cms/data/uploads
#   PREVIEW_SECRET=
