# Másold .env-be és töltsd ki. A .env nincs verziókövetve.

# A nyilvános kapcsolati cím, ahogy az oldalon megjelenik.
PUBLIC_CONTACT_EMAIL=

# A form-szolgáltató JSON endpointja, pl.
#   Formspree:  https://formspree.io/f/xxxxxxxx
#   Basin:      https://usebasin.com/f/xxxxxxxx
#   Web3Forms:  https://api.web3forms.com/submit
# Üresen hagyva a Küldés a látogató levelezőjét nyitja meg.
PUBLIC_CONTACT_ENDPOINT=

# Csak Web3Forms-hoz kell (a kulcs a kérés törzsében utazik, nem az URL-ben).
PUBLIC_CONTACT_ACCESS_KEY=

# A futó konténer hosztportja.
PORT=8080

# Ha az oldal egy reverse proxy al-útvonalán áll, a prefix / nélkül (pl.
# portfolio). Üresen a domain gyökerére épül.
BASE_PATH=

# A Ghost CMS. Csak a portfólió szervere kéri le, a látogató soha (a képeket is
# a szerver adja tovább), így a CMS-nek nem kell nyilvánosnak lennie.
#
#   GHOST_URL           ahonnan a dev szerver (npm run dev) olvas; a konténer
#                       a compose hálózaton éri el, azt nem kell itt megadni
#   GHOST_CONTENT_KEY   Ghost admin → Settings → Integrations → Add custom
#                       integration → Content API key
GHOST_URL=http://localhost:2368
GHOST_CONTENT_KEY=
