# Másold .env-be és töltsd ki. A .env nincs verziókövetve.

# A nyilvános kapcsolati cím, ahogy az oldalon megjelenik.
PUBLIC_CONTACT_EMAIL=

# A form-szolgáltató JSON endpointja, pl.
#   Formspree:  https://formspree.io/f/xxxxxxxx
#   Basin:      https://usebasin.com/f/xxxxxxxx
#   Web3Forms:  https://api.web3forms.com/submit
# Üresen hagyva a Küldés a látogató levelezőjét nyitja meg.
PUBLIC_CONTACT_ENDPOINT=

# Csak Web3Forms-hoz kell (a kulcs a kérés törzsében utazik, nem az URL-ben).
PUBLIC_CONTACT_ACCESS_KEY=

# A futó konténer hosztportja.
PORT=8080

# A Directus CMS. Három cím, mert három különböző helyről kérik le.
#
#   DIRECTUS_URL         ahonnan a hoszton futó `npm run build` olvas
#   DIRECTUS_BUILD_URL   ugyanez a `docker compose build` konténeréből;
#                        Docker Desktopon host.docker.internal, Linux hoszton
#                        ehhez kell az extra_hosts: host-gateway a compose-ban
#   PUBLIC_DIRECTUS_URL  ami a kész HTML képcímeibe kerül, és amit a LÁTOGATÓ
#                        böngészője kér le — élesben ez a nyilvános cím
#
# Élesben mindhárom lehet egyszerűen https://cms.martinporkolab.hu.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_BUILD_URL=http://host.docker.internal:8055
PUBLIC_DIRECTUS_URL=http://localhost:8055
