---
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import plateHome from '../assets/bigger-bg.jpeg';
import plateWall from '../assets/plate-wall.jpeg';
import plateAbout from '../assets/plate-about.jpeg';
import { Font } from 'astro:assets';
import '../styles/global.css';
import { languages, defaultLang, t, type Lang } from '../i18n/ui';
import { absolute, alternates, ogLocale, person, website, webPage, jsonLd } from '../lib/seo';

interface Props {
  title: string;
  lang: Lang;
  description?: string;
  /**
   * The page's one <h1>, read by search engines and screen readers only — for
   * the photographed rooms, whose visible type is all signage.
   */
  heading?: string;
  /** The picture a shared link shows; the concourse when left out. Absolute. */
  image?: { src: string; alt: string; width?: number; height?: number };
  /** 'article' for a case study; a plain page otherwise. */
  ogType?: 'website' | 'article';
  /** The schema.org type of the page itself, e.g. ProfilePage. */
  pageType?: string;
  /** More JSON-LD nodes for this page: a project, its breadcrumbs. */
  schema?: object[];
  /** Kept out of search results: an error page is no page of the site. */
  noindex?: boolean;
}

const {
  title,
  lang,
  description = t(lang)('meta.home'),
  heading,
  image,
  ogType = 'website',
  pageType,
  schema = [],
  noindex = false,
} = Astro.props;

// The turn between two photographed rooms only works if the room you are turning
// towards is already decoded. Warmed after load, and only where plates are used.
const plates = await Promise.all(
  [plateHome, plateWall, plateAbout].map((src) =>
    getImage({ src, width: 1600, format: 'avif', quality: 68 }),
  ),
);
const plateUrls = plates.map((image) => image.src);

// '' by default, or '/<prefix>' when the site is served from a sub-path.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// One address per page, and the same page in the other language beside it.
const canonical = absolute(Astro.url.pathname);
const alternate = alternates(Astro.url.pathname);

// Link previews (Open Graph) want a plain JPEG at a fixed address: public/og.jpg
// is the concourse at 1200×630, public/portrait.jpg the photo on the profile.
// On a page rendered on request getImage() gives a /_image URL instead, which
// a scraper may not be able to follow.
const share = image ?? {
  src: absolute(`${base}/og.jpg`),
  alt: title,
  width: 1200,
  height: 630,
};
const faceUrl = absolute(`${base}/portrait.jpg`);

const graph = [
  website(lang),
  person(lang, faceUrl),
  webPage({ url: canonical, title, description, lang, type: pageType, image: share.src }),
  ...schema,
];
---

<!doctype html>
<!--
THESIS: The portfolio as a high-speed, hyper-legible transit corridor: read the concourse sign, pick a destination, reach the work.
OWN-WORLD: Terminal wayfinding — an overhead sign bar in deep blue over illuminated light-box panels, strict arrows, massive uppercase Inter.
STORY: The visitor sees three destinations overhead (Profile, Projects, Contact), the current work and the featured project below, and the outbound gates last.
FORM: Terminal Wayfinding (challenger-wayfinding), recoloured deep blue via --sign.
-->
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Porkoláb Martin" />
    <meta
      name="robots"
      content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="theme-color" content="#0d1117" />

    <link rel="canonical" href={canonical} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={alternate[l]} />)}
    <link rel="alternate" hreflang="x-default" href={alternate[defaultLang]} />
    <link rel="sitemap" type="application/xml" href={`${base}/sitemap.xml`} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Porkoláb Martin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {languages.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={share.src} />
    {share.width && <meta property="og:image:width" content={String(share.width)} />}
    {share.height && <meta property="og:image:height" content={String(share.height)} />}
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={share.src} />
    <meta name="twitter:image:alt" content={share.alt} />

    <script type="application/ld+json" set:html={jsonLd(graph)} />
    {/* The portfolio mark, on the terminal's own dark ground so it reads the
        same in a light and a dark browser chrome. */}
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    {/* Preferred where it is supported: one file, sharp at every size. The
        raster pair above stays for the browsers that ignore it. */}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" href={`${base}/favicon-32.png`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-inter" preload={[{ weight: 900, subset: 'latin' }]} />

    <ClientRouter />

    <script is:inline define:vars={{ plateUrls }}>
      // Warm the other plates once this page is settled. Wide viewports only:
      // narrow ones never render a plate, and should not pay for one.
      window.addEventListener('load', () => {
        if (!window.matchMedia('(min-width: 1024px) and (min-aspect-ratio: 1 / 1)').matches) return;
        if (navigator.connection?.saveData) return;
        const warm = () => plateUrls.forEach((url) => { new Image().src = url; });
        'requestIdleCallback' in window ? requestIdleCallback(warm, { timeout: 3000 }) : setTimeout(warm, 1200);
      });
    </script>
  </head>
  <body
    class="concourse bg-ground text-ground-ink font-sans antialiased overflow-x-hidden"
    style={`--concourse-image:url(${plateUrls[0]})`}
  >
    <!--
      Camera-turn blur, the way a game does it: the smear runs along the axis the
      camera is sweeping (horizontal), never across it, and its length tracks the
      angular velocity rather than the elapsed time. CSS blur() is isotropic, so
      the directional version has to come from an SVG filter; the transition steps
      through these fixed strengths instead of interpolating, which is invisible
      at this speed.
    -->
    <svg class="turn-blur-defs" aria-hidden="true" focusable="false">
      <filter id="turn-blur-1" x="-30%" y="-10%" width="160%" height="120%" color-interpolation-filters="sRGB">
        <feGaussianBlur stdDeviation="6 0" />
      </filter>
      <filter id="turn-blur-2" x="-30%" y="-10%" width="160%" height="120%" color-interpolation-filters="sRGB">
        <feGaussianBlur stdDeviation="16 0" />
      </filter>
      <filter id="turn-blur-3" x="-30%" y="-10%" width="160%" height="120%" color-interpolation-filters="sRGB">
        <feGaussianBlur stdDeviation="30 0" />
      </filter>
      <filter id="turn-blur-4" x="-30%" y="-10%" width="160%" height="120%" color-interpolation-filters="sRGB">
        <feGaussianBlur stdDeviation="44 0" />
      </filter>
    </svg>

    {heading && <h1 class="sr-only">{heading}</h1>}

    <slot />

    <script>
      // Switching language lands on the same room in another language, so the
      // camera has no reason to turn: a pan that ends where it started reads as
      // a glitch. The flag has to be re-set inside the transition as well —
      // Astro copies the new document's <html> attributes over mid-swap, which
      // would otherwise drop it half way through the animation.
      const samePlace = (from: URL, to: URL) => {
        const room = (url: URL) => url.pathname.replace(/^\/hu(?=\/|$)/, '').replace(/\/$/, '') || '/';
        return room(from) === room(to);
      };
      let holding = false;
      const holdStill = () => document.documentElement.setAttribute('data-no-turn', '');

      document.addEventListener('astro:before-preparation', (event) => {
        const move = event as unknown as {
          from: URL;
          to: URL;
          direction: string;
          sourceElement?: Element;
        };

        holding = samePlace(move.from, move.to);
        if (holding) holdStill();

        // Astro's router calls every link click a "forward" navigation — it does
        // not read data-astro-transition off the link (that attribute is only
        // ever written to <html>). The direction is writable here, though, so
        // this is where a link marked as a way back becomes one: without it the
        // camera turned the same way coming and going.
        const marked = move.sourceElement?.closest?.('[data-astro-transition]');
        if (marked?.getAttribute('data-astro-transition') === 'back') {
          move.direction = 'back';
        }
      });

      // The swap replaces <html>'s attributes with the incoming document's, and
      // it happens at the *start* of the animation, not the end — so the flag
      // has to be put back, and only dropped once the transition is really over.
      document.addEventListener('astro:after-swap', () => {
        if (holding) holdStill();
      });
      document.addEventListener('astro:before-swap', (event) => {
        const swap = event as unknown as { viewTransition?: { finished: Promise<void> } };
        if (!holding) return;
        swap.viewTransition?.finished.finally(() => {
          holding = false;
          document.documentElement.removeAttribute('data-no-turn');
        });
      });
    </script>

    <script>
      // Terminal clocks: the time where the work is made, which is Budapest —
      // a departures board shows local time, not UTC. Minute resolution,
      // wherever a [data-clock] sits.
      //
      // Module scripts run once per full page load, never again on a client-side
      // navigation, so the clock has to be re-bound to the new document's <time>
      // elements on every page load — that is why it read --:-- on any page you
      // reached by clicking rather than by reloading.
      const inBudapest = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Budapest',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      });

      const tick = () => {
        const time = inBudapest.format(new Date());
        document.querySelectorAll<HTMLTimeElement>('[data-clock]').forEach((clock) => {
          clock.textContent = time;
          clock.dateTime = time;
        });
      };

      tick();
      setInterval(tick, 15_000);
      document.addEventListener('astro:page-load', tick);
    </script>
  </body>
</html>
