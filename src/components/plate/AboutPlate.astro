---
import PlateScene from './PlateScene.astro';
import Panel from './Panel.astro';
import Arrow from '../Arrow.astro';
import plateAbout from '../../assets/plate-about.jpeg';
import { ABOUT_PLATE, aboutPanels as q } from '../../lib/panels';
import { t, path, type Lang, here as currentPath } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const here = currentPath(Astro.url.pathname);
---

<PlateScene plate={plateAbout} width={ABOUT_PLATE.w} height={ABOUT_PLATE.h} class="about">
  <!-- One panel per block: dark ink on light boxes, never a blue sign here. -->
  <Panel quad={q.intro} class="sheet sheet--intro">
    <span class="sheet__eyebrow">{tr('about.eyebrow')}</span>
    <h1 class="sheet__title">{tr('about.title')}</h1>
    <p class="sheet__lede">{tr('about.lede')}</p>
  </Panel>

  <Panel quad={q.story} class="sheet">
    {tr('about.body').split('\n').map((para) => <p class="sheet__body">{para}</p>)}
  </Panel>

  <Panel quad={q.facts} class="sheet">
    <span class="sheet__eyebrow">{tr('about.langTitle')}</span>
    <p class="sheet__list">{tr('about.langs')}</p>
  </Panel>

  <Panel quad={q.clock} surface="sign" bleed={4} class="wedge">
    <time data-clock datetime="">--:--</time>
  </Panel>

  <!-- The column lightbox is the gate sign: identity and the way back. -->
  <Panel quad={q.marker} surface="sign" bleed={6} class="marker">
    <span class="marker__gate">Gate A1</span>
    <span class="marker__name">{tr('site.name')}</span>
    <span class="marker__langs">
      <a href={path('en', here)} hreflang="en" class:list={['marker__pick', lang === 'en' && 'is-on']}>EN</a>
      <a href={path('hu', here)} hreflang="hu" class:list={['marker__pick', lang === 'hu' && 'is-on']}>HU</a>
    </span>
    <a href={path(lang, '/')} data-astro-transition="back" class="marker__back">
      <Arrow dir="back" class="marker__arrow" />
      {tr('nav.backShort')}
    </a>
  </Panel>
</PlateScene>

<style is:global>
  .about .sheet {
    display: flex;
    flex-direction: column;
    padding: 52px 40px;
    color: var(--panel-ink);
  }

  .about .sheet__eyebrow {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--panel-ink) 50%, transparent);
  }

  .about .sheet__eyebrow--gap {
    margin-top: 40px;
    padding-top: 26px;
    border-top: 3px solid color-mix(in srgb, var(--panel-ink) 20%, transparent);
  }

  .about .sheet__title {
    margin: 18px 0 0;
    font-size: 78px;
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .about .sheet__lede {
    margin: 28px 0 0;
    font-size: 38px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .about .sheet__body {
    margin: 24px 0 0;
    font-size: 32px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--panel-ink) 80%, transparent);
  }

  .about .sheet__list {
    margin: 16px 0 0;
    font-size: 32px;
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .about .marker {
    display: flex;
    flex-direction: column;
    padding: 34px 30px;
    color: var(--sign-ink);
  }

  .about .marker__gate {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .about .marker__name {
    margin-top: 18px;
    font-size: 62px;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .about .marker__langs {
    display: flex;
    gap: 12px;
    margin-top: auto;
  }

  .about .marker__pick {
    font-size: 32px;
    font-weight: 900;
    color: inherit;
    text-decoration: none;
    opacity: 0.5;
  }

  .about .marker__pick.is-on {
    opacity: 1;
    box-shadow: inset 0 -6px 0 currentColor;
  }

  .about .marker__back {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
    padding-top: 22px;
    border-top: 4px solid #ffffff33;
    color: inherit;
    text-decoration: none;
    font-size: 28px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .about .marker__arrow {
    width: 36px;
    height: 36px;
    flex: none;
    transition: transform 200ms ease;
  }

  .about .marker__back:hover .marker__arrow {
    transform: translateX(-10px);
  }

  .about .wedge {
    display: grid;
    place-items: center;
    color: var(--sign-ink);
    font-size: 68px;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  @media (prefers-reduced-motion: reduce) {
    .about .marker__arrow {
      transition: none;
    }
  }
</style>
