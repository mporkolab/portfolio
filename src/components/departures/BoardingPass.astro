---
import Cover from './Cover.astro';
import { copyFor, assetUrl } from '../../lib/projects';
import { fill, type Flight } from '../../lib/flights';
import { t, path, type Lang } from '../../i18n/ui';

/**
 * A project as a boarding pass on paper. Only what the CMS has is printed:
 * a project without a blurb, stack or cover simply has less on its pass.
 */
interface Props {
  lang: Lang;
  flight: Flight;
  /** The home page's featured pass: two columns and a tear-off stub. */
  variant?: 'default' | 'wide';
  /** Headings inside the pass, one level under the section it sits in. */
  level?: 'h2' | 'h3';
}
const { lang, flight, variant = 'default', level: Title = 'h3' } = Astro.props;
const tr = t(lang);

const { project, code, iata } = flight;
const { title, role, blurb } = copyFor(project, lang);
const href = path(lang, `/projects/${project.slug}`);
const live = project.status === 'live';
const wide = variant === 'wide';
const cover = project.thumbnail ? assetUrl(project.thumbnail, wide ? 1280 : 720) : undefined;
// On the wide pass a logo goes on the stub; the main side keeps a screenshot only.
const showCover = wide ? !!cover && !project.thumbnail_is_logo : true;
---

<article class:list={['pass', wide && 'pass--wide']}>
  <header class="pass__band">
    <span>{tr('pass.title')} · {code}</span>
    {role && <span class="pass__type">{role}</span>}
  </header>

  <div class="pass__body">
    <div class="pass__main">
      {
        showCover && (
          <Cover
            label={title}
            src={cover}
            logo={project.thumbnail_is_logo}
            class="pass__cover"
          />
        )
      }

      <div class="pass__details">
        <p class="pass__route">
          <span class="sr-only">{fill(tr('pass.route'), { code: iata })}</span>
          <span class="pass__port" aria-hidden="true">
            <span class="pass__portLabel">{tr('pass.from')}</span>
            BUD
          </span>
          <svg class="pass__arrow" viewBox="0 0 64 16" aria-hidden="true">
            <path d="M0 8h60M53 2l7 6-7 6" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span class="pass__port" aria-hidden="true">
            <span class="pass__portLabel">{tr('pass.to')}</span>
            {iata}
          </span>
        </p>

        <Title class="pass__title">{title}</Title>
        {blurb && <p class="pass__blurb">{blurb}</p>}

        <dl class="pass__fields">
          <div>
            <dt>{tr('pass.flight')}</dt>
            <dd>{code}</dd>
          </div>
          {
            wide && (
              <div>
                <dt>{tr('pass.gate')}</dt>
                <dd>A2</dd>
              </div>
            )
          }
          {
            project.stack && (
              <div class="pass__wide">
                <dt>{tr('pass.stack')}</dt>
                <dd>{project.stack}</dd>
              </div>
            )
          }
          <div>
            <dt>{tr('pass.status')}</dt>
            <dd class:list={[live && 'is-live']}>
              {live && <span class="led" aria-hidden="true" />}
              {live ? tr('board.status.live') : tr('board.status.dev')}
            </dd>
          </div>
        </dl>

        <div class="pass__foot">
          <a href={href} class="btn btn--ink">
            {tr('board.readCase')} <span aria-hidden="true">→</span>
          </a>
          {!wide && <span class="barcode pass__barcode" aria-hidden="true" />}
        </div>
      </div>
    </div>

    {
      wide && (
        <aside class="pass__stub">
          <div class="pass__logo">
            {cover && project.thumbnail_is_logo ? (
              <img src={cover} alt="" loading="lazy" decoding="async" />
            ) : (
              <span aria-hidden="true">{iata}</span>
            )}
          </div>
          <span class="barcode pass__stubCode" aria-hidden="true" />
          {project.live_url && (
            <a href={project.live_url} target="_blank" rel="noopener noreferrer" class="pass__site">
              {tr('pass.site')} <span aria-hidden="true">↗</span>
            </a>
          )}
        </aside>
      )
    }
  </div>
</article>

<style>
  .pass {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--paper);
    color: var(--ink);
  }

  .pass__band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 12px 20px;
    background: var(--amber);
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pass__type {
    font-weight: 500;
  }

  .pass__body {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
  }

  .pass__main {
    flex: 1 1 320px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pass__cover {
    aspect-ratio: 16 / 9;
  }

  .pass__details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px 20px 20px;
  }

  .pass__route {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    margin: 0;
  }

  .pass__port {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 64px);
    font-weight: 900;
    line-height: 0.9;
  }

  .pass__portLabel {
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    line-height: 1.2;
  }

  .pass__arrow {
    flex: 1;
    max-width: 120px;
    height: 16px;
    margin-bottom: 0.6em;
    color: var(--ink-muted);
  }

  .pass__title {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .pass__blurb {
    margin: 0;
    max-width: 52ch;
    color: #2e2c28;
    font-size: 15px;
    line-height: 1.6;
  }

  .pass__fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 12px 20px;
    margin: 4px 0 0;
    padding-top: 14px;
    border-top: 2px dashed var(--ink-line);
  }

  .pass__wide {
    grid-column: 1 / -1;
  }

  .pass__fields dt {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .pass__fields dd {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 2px 0 0;
    font-size: 15px;
    font-weight: 600;
  }

  .pass__fields dd.is-live {
    color: var(--green-ink);
  }

  .pass__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 10px;
  }

  .pass__barcode {
    width: 110px;
    min-width: 0;
  }

  .pass__stub {
    flex: 0 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 20px;
    border-top: 2px dashed var(--ink-line);
  }

  .pass__logo {
    display: grid;
    place-items: center;
    width: 96px;
    aspect-ratio: 1;
    border-radius: 8px;
    background: var(--ink);
    color: var(--amber);
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 900;
  }

  .pass__logo img {
    width: 80%;
    height: 80%;
    object-fit: contain;
  }

  .pass__stubCode {
    flex: 1;
    max-width: 180px;
    height: 56px;
  }

  .pass__site {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* The featured pass: screenshot and details side by side, the stub torn off on the right. */
  @media (min-width: 900px) {
    .pass--wide .pass__main {
      flex-direction: row;
    }

    .pass--wide .pass__cover {
      flex: 0 0 46%;
      aspect-ratio: auto;
      min-height: 320px;
    }

    .pass--wide .pass__details {
      padding: 28px;
    }

    .pass--wide .pass__stub {
      width: 220px;
      flex-direction: column;
      justify-content: center;
      border-top: 0;
      border-left: 2px dashed var(--ink-line);
    }

    .pass--wide .pass__stubCode {
      flex: none;
      width: 140px;
    }
  }
</style>
