---
/** A visa stamp on the passport page: three lines in a double ring, slightly askew. */
interface Props {
  /** Three lines, newline-separated: the verdict first. */
  text: string;
  color: string;
  shape: 'round' | 'rect';
  /** Degrees. */
  tilt: number;
}
const { text, color, shape, tilt } = Astro.props;
const [head, ...rest] = text.split('\n');
---

<p class:list={['stamp', `stamp--${shape}`]} style={`--ink:${color};--tilt:${tilt}deg`}>
  <span class="stamp__head">{head}</span>
  {rest.map((line) => <span class="stamp__line">{line}</span>)}
</p>

<style>
  .stamp {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    margin: 0;
    padding: 14px 18px;
    border: 4px double var(--ink);
    color: var(--ink);
    text-align: center;
    text-transform: uppercase;
    transform: rotate(var(--tilt));
    mix-blend-mode: multiply;
  }

  .stamp--round {
    border-radius: 50%;
    min-height: 132px;
    padding-inline: 26px;
  }

  .stamp--rect {
    border-radius: 12px;
    min-height: 112px;
  }

  .stamp__head {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .stamp__line {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.35;
  }
</style>
