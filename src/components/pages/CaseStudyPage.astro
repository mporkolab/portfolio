---
import PageShell from '../PageShell.astro';
import Arrow from '../Arrow.astro';
import Thumb from '../Thumb.astro';
import { copyFor, assetUrl, type Project } from '../../lib/projects';
import { t, path, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project } = Astro.props;
const tr = t(lang);

const { title, role, blurb, story, note } = copyFor(project, lang);
const statusLabel = project.status === 'live' ? tr('board.status.live') : tr('board.status.dev');
---
<PageShell
  crumb={tr('nav.project')}
  up={{ href: path(lang, '/projects'), label: tr('nav.backProjects') }}
  lang={lang}
  title={title}
  eyebrow={`${tr('projects.title')} — ${statusLabel}`}
>
  <div class="max-w-4xl">
    <p class="text-sm sm:text-base font-bold uppercase tracking-[0.2em] text-panel-ink/60">{role}</p>
    <p class="mt-5 text-xl sm:text-2xl font-bold leading-snug">{blurb}</p>

    <Thumb
      label={title}
      src={project.thumbnail ? assetUrl(project.thumbnail, 1280) : undefined}
      logo={project.thumbnail_is_logo}
      sizes="(max-width: 640px) 100vw, 896px"
      class="mt-10 w-full aspect-[16/9]"
    />

    {story && (
      <div
        class="mt-10 border-t-2 border-panel-ink pt-8 flex flex-col gap-4 text-base sm:text-lg leading-relaxed text-panel-ink/80 [&_a]:underline [&_strong]:font-bold [&_img]:max-w-full [&_img]:h-auto [&_figcaption]:mt-2 [&_figcaption]:text-sm"
        set:html={story}
      />
    )}

    {project.stack && (
      <dl class="mt-10 border-t-2 border-panel-ink pt-8">
        <dt class="text-xs font-bold uppercase tracking-[0.3em] text-panel-ink/60">Stack</dt>
        <dd class="mt-3 text-lg sm:text-2xl font-black uppercase tracking-tight">{project.stack}</dd>
      </dl>
    )}

    <!-- A caveat the project itself carries, e.g. no accuracy figures while a
         model is still in development. -->
    {note && (
      <p
        class="mt-10 border-t-2 border-panel-ink pt-6 text-xs sm:text-sm font-bold uppercase tracking-[0.25em] text-panel-ink/50"
        set:html={note}
      />
    )}

    <!-- Only where there is something live to visit. -->
    {project.live_url && (
      <a
        href={project.live_url}
        target="_blank"
        rel="noopener noreferrer"
        class="panel-box group mt-10 flex items-center justify-between gap-6 border-t-2 border-panel-ink py-6 sm:py-8 hover:bg-panel-ink/[0.04] transition-colors"
      >
        <span class="text-xl sm:text-4xl font-black uppercase tracking-tighter leading-none">{tr('board.visit')}</span>
        <Arrow dir="out" class="w-8 h-8 sm:w-12 sm:h-12 shrink-0 transition-transform group-hover:-translate-y-1 group-hover:translate-x-1" />
      </a>
    )}
  </div>
</PageShell>
