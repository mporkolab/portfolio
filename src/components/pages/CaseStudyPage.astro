---
import Page from '../departures/Page.astro';
import Crumbs from '../departures/Crumbs.astro';
import SplitFlap from '../departures/SplitFlap.astro';
import Cover from '../departures/Cover.astro';
import NextGate from '../departures/NextGate.astro';
import { getProjects, copyFor, assetUrl, type Project } from '../../lib/projects';
import { flights, iataFor, type Flight } from '../../lib/flights';
import { legs, hasLegs } from '../../lib/flightlog';
import { t, path, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project } = Astro.props;
const tr = t(lang);

const { title, role, blurb, story, note } = copyFor(project, lang);
const live = project.status === 'live';

// The flight number is the project's place on the board. A draft seen through
// a preview link is on no board yet, so it flies as -00.
const list = flights(await getProjects());
const at = list.findIndex((f) => f.project.slug === project.slug);
const self: Flight = at >= 0 ? list[at] : { project, iata: iataFor(project.slug), code: `${iataFor(project.slug)}-00` };
const next = list.length > 1 ? list[(at + 1) % list.length] : undefined;

const legLabels = [tr('leg.1'), tr('leg.2'), tr('leg.3'), tr('leg.4')];
const legLabel = (i: number) => legLabels[i] ?? tr('leg.more');

// With <h2>s the story is cut at them. Without, it is all one check-in, and the
// landing is the way to the live site, if there is one.
const split = hasLegs(story);
const sections = split ? legs(story) : story ? [{ heading: null, body: story }] : [];
const landing = !split && !!project.live_url;

const cover = project.thumbnail ? assetUrl(project.thumbnail, 1280) : undefined;
---

<Page lang={lang}>
  <div class="wrap case">
    <Crumbs back={{ href: path(lang, '/projects'), label: tr('nav.backProjects') }}>
      {tr('case.crumb')} · {self.code}
      <span class:list={['case__status', live && 'is-live']}>
        {live && <span class="led" aria-hidden="true" />}
        {live ? tr('board.status.live') : tr('board.status.dev')}
      </span>
    </Crumbs>

    <SplitFlap text={title} size="lg" as="h1" />
    {blurb && <p class="case__blurb">{blurb}</p>}

    <div class="route">
      <p class="route__ports">
        <span class="sr-only">{tr('pass.from')} BUD — {tr('pass.to')} {self.iata}</span>
        <span aria-hidden="true" class="route__port"><span class="route__label">{tr('pass.from')}</span>BUD</span>
        <span aria-hidden="true" class="route__arrow">→</span>
        <span aria-hidden="true" class="route__port"><span class="route__label">{tr('pass.to')}</span>{self.iata}</span>
      </p>
      {
        (role || project.stack) && (
          <dl class="route__fields">
            {role && (
              <div>
                <dt>{tr('pass.type')}</dt>
                <dd>{role}</dd>
              </div>
            )}
            {project.stack && (
              <div>
                <dt>{tr('pass.stack')}</dt>
                <dd>{project.stack}</dd>
              </div>
            )}
          </dl>
        )
      }
    </div>

    {cover && <Cover label={title} src={cover} logo={project.thumbnail_is_logo} eager class="case__hero" />}

    <div class="legs">
      {
        sections.map((leg, i) => (
          <section class="leg">
            <div class="leg__side">
              <p class="leg__tag">
                <SplitFlap text={String(i + 1)} size="sm" color="amber" as="span" decorative />
                {legLabel(i)}
              </p>
              {leg.heading && <h2 class="leg__title display" set:html={leg.heading} />}
            </div>
            <div class="leg__body story" set:html={leg.body} />
          </section>
        ))
      }

      {
        landing && (
          <section class="leg">
            <div class="leg__side">
              <p class="leg__tag">
                <SplitFlap text={String(sections.length + 1)} size="sm" color="amber" as="span" decorative />
                {tr('leg.4')}
              </p>
            </div>
            <div class="leg__body">
              <a href={project.live_url} target="_blank" rel="noopener noreferrer" class="btn btn--amber">
                {tr('board.visit')} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>
        )
      }
    </div>

    <!-- A caveat the project itself carries, e.g. no accuracy figures while a
         model is still in development. -->
    {note && <p class="case__note label" set:html={note} />}

    {
      split && project.live_url && (
        <p class="case__visit">
          <a href={project.live_url} target="_blank" rel="noopener noreferrer" class="btn btn--amber">
            {tr('board.visit')} <span aria-hidden="true">↗</span>
          </a>
        </p>
      )
    }
  </div>

  {
    next ? (
      <NextGate
        href={path(lang, `/projects/${next.project.slug}`)}
        label={`${tr('next.flight')} · ${next.code}`}
        code={next.iata}
        name={copyFor(next.project, lang).title}
      />
    ) : (
      <NextGate href={path(lang, '/projects')} label={tr('next.gate')} code="A2" name={tr('gate.projects')} />
    )
  }
</Page>

<style>
  /* A case study is read, not scanned: one centred column, the width of a
     comfortable line of mono text. */
  .case {
    max-width: calc(800px + 2 * var(--gutter));
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 32px);
  }

  /* The title's flaps sized to the column: a nine-letter word still fits. */
  .case :global(.flap--lg) {
    --w: clamp(24px, 7.6vw, 80px);
    --fs: clamp(21px, 6.8vw, 72px);
  }

  .case__status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--amber);
  }

  .case__status.is-live {
    color: var(--green);
  }

  .case__blurb {
    max-width: 60ch;
    margin: 0;
    color: var(--text-2);
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.6;
  }

  .route {
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--paper);
    color: var(--ink);
  }

  .route__ports {
    flex: 0 1 auto;
    display: flex;
    align-items: flex-end;
    gap: 16px;
    margin: 0;
    padding: 20px 24px;
    background: var(--amber);
  }

  .route__port {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 900;
    line-height: 0.9;
  }

  .route__label {
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .route__arrow {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 44px);
    line-height: 1;
  }

  .route__fields {
    flex: 1 1 280px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    align-content: center;
    gap: 14px 28px;
    margin: 0;
    padding: 20px 24px;
  }

  .route__fields dt {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .route__fields dd {
    margin: 2px 0 0;
    font-size: 16px;
    font-weight: 600;
  }

  .case__hero {
    aspect-ratio: 16 / 8;
    border: 1px solid var(--line);
    border-radius: var(--r-board);
    background: var(--surface);
  }

  .legs {
    display: flex;
    flex-direction: column;
  }

  /* The leg's number and heading above its text, not beside it: beside, a
     story without <h2>s left a column of nothing on the left. */
  .leg {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: clamp(28px, 4vw, 48px);
    border-top: 1px solid var(--line);
  }

  .leg__side {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .leg__tag {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    color: var(--amber);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .leg__title {
    margin: 0;
    font-size: clamp(32px, 4vw, 52px);
    color: var(--text);
  }

  .leg__body {
    min-width: 0;
  }

  .leg__body.story {
    max-width: none;
  }

  .case__note {
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .case__visit {
    margin: 0;
  }
</style>
