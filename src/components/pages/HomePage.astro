---
import Page from '../departures/Page.astro';
import SplitFlap from '../departures/SplitFlap.astro';
import FlapBoard, { type BoardRow } from '../departures/FlapBoard.astro';
import BoardingPass from '../departures/BoardingPass.astro';
import Clock from '../departures/Clock.astro';
import { getProjects } from '../../lib/projects';
import { flights, featuredFlight, fill } from '../../lib/flights';
import { t, path, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

// The board counts what the CMS has published; nothing here names a project.
const list = flights(await getProjects());
const n = list.length;
const nLive = list.filter((f) => f.project.status === 'live').length;
const featured = featuredFlight(list);

const row = (gate: string, to: string, dest: string, remarks: string, status: string, color: 'amber' | 'green' | 'text'): BoardRow => ({
  href: path(lang, to),
  ariaLabel: `${tr('col.gate')} ${gate} — ${dest}, ${remarks}, ${status}`,
  cells: [
    { text: gate, length: 2, color: 'amber' },
    { text: dest, length: 9 },
    { text: remarks, length: 16 },
    { text: status, length: 9, color },
  ],
});

const rows = [
  row('A1', '/about', tr('row.profile'), tr('row.profile.remarks'), tr('row.profile.status'), 'amber'),
  row('A2', '/projects', tr('row.projects'), fill(tr('row.projects.remarks'), { n }), fill(tr('row.projects.status'), { n: nLive }), 'green'),
  row('A3', '/contact', tr('row.contact'), tr('row.contact.remarks'), tr('row.contact.status'), 'text'),
];
---

<Page lang={lang} home>
  <div class="wrap home">
    <div class="home__top">
      <p class="home__departures label">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
          <path d="M2.5 19h19M3.5 13.5l3.2 1 4-1.3L6.4 6l2.2-.7 7.2 6.1 4.3-1.4a1.6 1.6 0 0 1 1 3l-15 4.9-3.6-3.2z" />
        </svg>
        {tr('home.departures')}
      </p>
      <Clock lang={lang} />
    </div>

    <h1 class="hero">
      <span class="sr-only">Porkoláb Martin</span>
      <SplitFlap text="Porkoláb" size="xl" as="span" decorative class="hero__line" />
      <SplitFlap text="Martin" size="xl" color="amber" as="span" delay={300} decorative class="hero__line" />
    </h1>

    <p class="tagline">{tr('home.tagline')}</p>

    <FlapBoard title={tr('home.board')} columns={[tr('col.gate'), tr('col.destination'), tr('col.remarks'), tr('col.status')]} rows={rows} />

    {
      featured && (
        <section class="boarding" aria-labelledby="boarding-title">
          <h2 class="label boarding__title" id="boarding-title">
            <span class="led led--blink" aria-hidden="true" />
            {tr('home.boarding')}
          </h2>
          <BoardingPass lang={lang} flight={featured} variant="wide" />
        </section>
      )
    }
  </div>
</Page>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 48px);
    padding-block: clamp(24px, 4vw, 48px) clamp(48px, 8vw, 96px);
  }

  .home__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .home__departures {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--amber);
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: clamp(4px, 0.8vw, 12px);
    margin: 0;
  }

  .tagline {
    max-width: 46ch;
    margin: 0;
    color: var(--text-2);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.65;
  }

  .boarding {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .boarding__title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--text-2);
  }

  .boarding__title .led {
    color: var(--green);
  }
</style>
