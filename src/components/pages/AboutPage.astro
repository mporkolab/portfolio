---
import Page from '../departures/Page.astro';
import Crumbs from '../departures/Crumbs.astro';
import SplitFlap from '../departures/SplitFlap.astro';
import Passport from '../departures/Passport.astro';
import Stamp from '../departures/Stamp.astro';
import NextGate from '../departures/NextGate.astro';
import { t, path, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

// The bio, as written: the lede in large type, the paragraphs after it, and
// the last one — the free time — off duty, below the fold of the page.
const paras = tr('about.body').split('\n');
const offDuty = paras.at(-1)!;
const statement = paras.slice(0, -1);

const stamps = [
  { text: tr('stamp.1'), color: 'var(--stamp-blue)', shape: 'round', tilt: -6 },
  { text: tr('stamp.2'), color: 'var(--stamp-red)', shape: 'rect', tilt: 4 },
  { text: tr('stamp.3'), color: 'var(--stamp-green)', shape: 'round', tilt: -3 },
  { text: tr('stamp.4'), color: 'var(--stamp-purple)', shape: 'rect', tilt: 7 },
] as const;
---

<Page lang={lang}>
  <div class="wrap about">
    <Crumbs back={{ href: path(lang, '/'), label: tr('crumb.departures') }}>{tr('about.crumb')}</Crumbs>

    <SplitFlap text={tr('about.title')} size="lg" color="amber" as="h1" />

    <Passport lang={lang} />

    <div class="spread">
      <section class="spread__page" aria-labelledby="statement">
        <h2 class="spread__label" id="statement">{tr('passport.statement')}</h2>
        <p class="spread__lede display">{tr('about.lede')}</p>
        {statement.map((p) => <p class="spread__text">{p}</p>)}
        <p class="spread__off">
          <span class="spread__label">{tr('passport.offDuty')} —</span>
          {offDuty}
        </p>
      </section>

      <section class="spread__page spread__page--visas" aria-labelledby="visas">
        <h2 class="spread__label" id="visas">{tr('passport.visas')}</h2>
        <div class="stamps">
          {stamps.map((s) => <Stamp {...s} />)}
        </div>
      </section>
    </div>
  </div>

  <NextGate href={path(lang, '/projects')} label={tr('next.gate')} code="A2" name={tr('gate.projects')} />
</Page>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3.5vw, 40px);
  }

  .spread {
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
    border-radius: var(--r-passport);
    background: var(--paper);
    color: var(--ink);
  }

  .spread__page {
    flex: 1 1 360px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(24px, 4vw, 48px);
    min-width: 0;
  }

  /* The fold between the two pages. */
  .spread__page--visas {
    border-left: 2px dashed var(--ink-line);
    margin-left: -2px;
  }

  .spread__label {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .spread__lede {
    margin: 0;
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1;
  }

  .spread__text {
    max-width: 60ch;
    margin: 0;
    color: #2e2c28;
    font-size: 16px;
    line-height: 1.7;
  }

  .spread__off {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 8px 0 0;
    padding-top: 16px;
    border-top: 2px dashed var(--ink-line);
    color: #2e2c28;
    font-size: 15px;
    line-height: 1.6;
  }

  .stamps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 28px 24px;
    align-items: center;
    padding: 12px 4px;
  }
</style>
