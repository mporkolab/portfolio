---
import PageShell from '../PageShell.astro';
import Thumb from '../Thumb.astro';
import predictorLogo from '../../assets/fp-clear.png';
import { t, path, type Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);

const story = tr('p.predictor.story').split('\n');
---
<PageShell crumb={tr('nav.project')} up={{ href: path(lang, '/projects'), label: tr('nav.backProjects') }} lang={lang} title={tr('p.predictor.title')} eyebrow={`${tr('projects.title')} — ${tr('board.status.dev')}`}>
  <div class="max-w-4xl">
    <p class="text-sm sm:text-base font-bold uppercase tracking-[0.2em] text-panel-ink/60">{tr('p.predictor.role')}</p>
    <p class="mt-5 text-xl sm:text-2xl font-bold leading-snug">{tr('p.predictor.blurb')}</p>

    <Thumb label={tr('p.predictor.title')} src={predictorLogo} logo sizes="(max-width: 640px) 100vw, 896px" class="mt-10 w-full aspect-[16/9]" />

    <div class="mt-10 border-t-2 border-panel-ink pt-8 flex flex-col gap-4">
      {story.map((para) => <p class="text-base sm:text-lg leading-relaxed text-panel-ink/80">{para}</p>)}
    </div>

    <p class="mt-10 border-t-2 border-panel-ink pt-6 text-xs sm:text-sm font-bold uppercase tracking-[0.25em] text-panel-ink/50">
      {tr('p.predictor.note')}
    </p>
  </div>
</PageShell>
