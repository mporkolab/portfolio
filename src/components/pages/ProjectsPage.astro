---
import Page from '../departures/Page.astro';
import Crumbs from '../departures/Crumbs.astro';
import SplitFlap from '../departures/SplitFlap.astro';
import FlapBoard, { type BoardRow } from '../departures/FlapBoard.astro';
import BoardingPass from '../departures/BoardingPass.astro';
import NextGate from '../departures/NextGate.astro';
import { getProjects, copyFor } from '../../lib/projects';
import { flights, caps, clip } from '../../lib/flights';
import { t, path, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

// Every published project, in the CMS's order; a new one is on the board the
// moment it is published there.
const list = flights(await getProjects());

const rows: BoardRow[] = list.map(({ project, code }) => {
  const { title, role } = copyFor(project, lang);
  const live = project.status === 'live';
  const status = live ? tr('flap.live') : tr('flap.dev');
  return {
    href: path(lang, `/projects/${project.slug}`),
    ariaLabel: [`${tr('col.flight')} ${code}`, title, role, live ? tr('board.status.live') : tr('board.status.dev')]
      .filter(Boolean)
      .join(' — '),
    cells: [
      { text: code, length: 6, color: 'amber' },
      { text: clip(caps(title), 14), length: 14 },
      { text: clip(caps(role), 12), length: 12 },
      { text: status, length: 10, color: live ? 'green' : 'amber' },
    ],
  };
});

// The open slot at the foot of the board: the visitor's own project.
rows.push({
  href: path(lang, '/contact'),
  ariaLabel: `${tr('row.next')} — ${tr('row.next.type')}`,
  faint: true,
  cells: [
    { text: `TBA-${String(list.length + 1).padStart(2, '0')}`, length: 6, color: 'amber' },
    { text: tr('row.next'), length: 14, color: 'amber' },
    { text: caps(tr('row.next.type')), length: 12, color: 'amber' },
    { text: tr('row.next.status'), length: 10, color: 'amber' },
  ],
});
---

<Page lang={lang}>
  <div class="wrap projects">
    <Crumbs back={{ href: path(lang, '/'), label: tr('crumb.departures') }}>{tr('projects.crumb')}</Crumbs>

    <SplitFlap text={tr('projects.title')} size="lg" color="amber" as="h1" />
    <p class="intro">{tr('projects.intro')}</p>

    <FlapBoard title={tr('projects.board')} columns={[tr('col.flight'), tr('col.destination'), tr('col.type'), tr('col.status')]} rows={rows} />

    {
      list.length > 0 && (
        <section class="passes" aria-labelledby="passes-title">
          <h2 class="label" id="passes-title">{tr('projects.passes')}</h2>
          <div class="passes__grid">
            {list.map((flight) => (
              <BoardingPass lang={lang} flight={flight} />
            ))}
          </div>
        </section>
      )
    }
  </div>

  <NextGate href={path(lang, '/contact')} label={tr('next.gate')} code="A3" name={tr('gate.contact')} />
</Page>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3.5vw, 40px);
  }

  .intro {
    max-width: 64ch;
    margin: -8px 0 0;
    color: var(--text-2);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.65;
  }

  .passes {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 16px;
  }

  .passes h2 {
    margin: 0;
  }

  .passes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 24px;
  }
</style>
