---
// Shows no project, so it is built once rather than on each request.
export const prerender = true;
import { t } from '../../i18n/ui';
import Layout from '../../layouts/Layout.astro';
import AboutPage from '../../components/pages/AboutPage.astro';

const lang = 'hu' as const;
const tr = t(lang);
---
<Layout title="Porkoláb Martin | Rólam" lang={lang} description={tr('meta.about')} pageType="ProfilePage">
  <AboutPage lang={lang} />
</Layout>
