---
import { path } from '../../../../i18n/ui';
import { projectPages } from '../../../../lib/projects';

// The photographed wall held four projects at a time, so its later sections
// had addresses of their own. The board lists every project on one page now:
// an address that used to be a wall section moves there for good; any other
// number is still a 404.
const pages = await projectPages();
const page = Number(Astro.params.n);
if (!Number.isInteger(page) || page < 2 || page > pages.length) {
  return new Response(null, { status: 404 });
}
return Astro.redirect(path('hu', '/projects'), 301);
---
