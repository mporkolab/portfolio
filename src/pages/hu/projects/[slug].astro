---
import Layout from '../../../layouts/Layout.astro';
import CaseStudyPage from '../../../components/pages/CaseStudyPage.astro';
import { getProjects, copyFor } from '../../../lib/projects';

// One case study per project in the CMS. A project published there has its
// page at once; nothing here names a project.
const project = (await getProjects()).find((p) => p.slug === Astro.params.slug);
if (!project) return new Response(null, { status: 404 });

const lang = 'hu' as const;
---
<Layout title={`${copyFor(project, lang).title} | Porkoláb Martin`} lang={lang}>
  <CaseStudyPage lang={lang} project={project} />
</Layout>
