---
import { t, path, type Lang } from '../i18n/ui';
import Layout from '../layouts/Layout.astro';
import Page from '../components/departures/Page.astro';
import Crumbs from '../components/departures/Crumbs.astro';
import SplitFlap from '../components/departures/SplitFlap.astro';

/**
 * What a visitor sees when a page fails on the server, instead of a blank 500.
 * Nearly always that is the CMS: its database not there yet (the CMS has never
 * started) or not readable. That is a passing outage, not a broken page, so
 * it is answered as one — 503 with Retry-After, which a search engine takes
 * as "come back later" rather than a reason to drop the page.
 */
interface Props {
  error?: unknown;
}
const { error } = Astro.props;

const cmsDown = error instanceof Error && error.message.startsWith('[cms]');
if (cmsDown) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

// The language of the page that failed: everything under /hu is Hungarian.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lang: Lang = /^\/hu(\/|$)/.test(Astro.url.pathname.slice(base.length)) ? 'hu' : 'en';
const tr = t(lang);
---
<Layout title={`${tr('error.title')} | Porkoláb Martin`} lang={lang} description={tr('error.body')} noindex>
  <Page lang={lang}>
    <div class="wrap error">
      <Crumbs back={{ href: path(lang, '/'), label: tr('crumb.departures') }}>{tr('error.eyebrow')}</Crumbs>
      <SplitFlap text={tr('error.title')} size="lg" color="amber" as="h1" />
      <p class="error__body">{tr('error.body')}</p>
    </div>
  </Page>
</Layout>

<style>
  .error {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: clamp(48px, 8vw, 96px);
  }

  .error__body {
    max-width: 52ch;
    margin: 0;
    color: var(--text-2);
    font-size: clamp(17px, 1.8vw, 21px);
  }
</style>
